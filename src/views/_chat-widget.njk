{# Floating job roles assistant. Include just before </body> on any page. #}
<div id="chat-widget" class="chat-widget">
  <button
    type="button"
    id="chat-toggle"
    class="chat-toggle"
    aria-expanded="false"
    aria-controls="chat-panel"
    aria-label="Open job roles assistant"
  >
    <span aria-hidden="true">💬</span>
  </button>

  <div
    id="chat-panel"
    class="chat-panel"
    role="dialog"
    aria-label="Job roles assistant"
    aria-modal="false"
    hidden
  >
    <div class="chat-header">
      <span class="chat-title">Job Roles Assistant</span>
      <button type="button" id="chat-close" class="chat-close" aria-label="Close chat">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <ul id="chat-messages" class="chat-messages" aria-live="polite">
      <li class="chat-msg chat-msg--bot">
        Hi! Ask me anything about the job roles we have open.
      </li>
    </ul>

    <form id="chat-form" class="chat-form" autocomplete="off">
      <label for="chat-input" class="chat-visually-hidden">Your question</label>
      <input
        type="text"
        id="chat-input"
        name="question"
        class="chat-input"
        maxlength="500"
        placeholder="e.g. What roles are open in Belfast?"
        required
      />
      <button type="submit" id="chat-send" class="chat-send">Send</button>
    </form>
  </div>
</div>

<script src="/chat.js" defer></script>
