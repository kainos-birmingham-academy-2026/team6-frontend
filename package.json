{
  "name": "team6-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "prepare": "npm run setup-hooks",
    "setup-hooks": "git config core.hooksPath .githooks",
    "build": "tsc -p tsconfig.json && copyfiles -u 2 \"src/views/**/*\" dist/views && copyfiles -u 2 \"src/public/**/*\" dist/public",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "lint:fix": "prettier --write \"src/**/*.{ts,tsx}\" && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:with-server": "start-server-and-test \"npm run build && npm run start\" http://localhost:3001 \"playwright test\"",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "form-data": "^4.0.6",
    "multer": "^2.2.0",
    "nunjucks": "^3.2.4",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/nunjucks": "^3.2.6",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "copyfiles": "^2.4.1",
    "prettier": "^3.0.0",
    "start-server-and-test": "^3.0.12",
    "supertest": "^7.1.1",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
