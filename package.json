{
  "name": "team6-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "prepare": "npm run setup-hooks",
    "setup-hooks": "git config core.hooksPath .githooks",
    "build": "tsc -p tsconfig.json && copyfiles -u 2 \"src/views/**/*\" dist/views && copyfiles -u 2 \"src/public/**/*\" dist/public",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "lint:fix": "prettier --write \"src/**/*.{ts,tsx}\" && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.1.2",
    "@types/nunjucks": "^3.2.6",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "prettier": "^3.0.0",
    "copyfiles": "^2.4.1",
    "supertest": "^7.1.1",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
